{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRP context exchange record 0.1-draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fictional", "context_id", "context_version", "parent_version", "scope", "level_vocabulary", "levels", "participants", "assumptions", "evidence_refs", "change", "acknowledgements", "unresolved"],
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "fictional": {"type": "boolean"},
    "context_id": {"$ref": "#/$defs/text"},
    "context_version": {"type": "integer", "minimum": 1},
    "parent_version": {"type": ["integer", "null"], "minimum": 1},
    "scope": {"$ref": "#/$defs/text"},
    "level_vocabulary": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "definitions"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"},
        "definitions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}, "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "levels": {"$ref": "#/$defs/levels"},
    "participants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "declared_access", "access_limits"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "role": {"$ref": "#/$defs/text"},
          "declared_access": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "access_limits": {"$ref": "#/$defs/text"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["proposer", "previous_levels", "description", "reason"],
      "properties": {
        "proposer": {"$ref": "#/$defs/text"},
        "previous_levels": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "description": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}
      }
    },
    "acknowledgements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["participant_id", "status", "scope", "basis"],
        "properties": {
          "participant_id": {"$ref": "#/$defs/text"},
          "status": {"enum": ["confirmed", "disputed", "unknown"]},
          "scope": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
