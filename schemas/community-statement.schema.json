{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRP community statement 0.1-draft",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fictional", "statement_id", "proposal_id", "target_commit", "issued_at", "statement_kind", "verdict", "actor", "mandate", "scope", "rationale", "evidence_refs", "conflicts", "independence", "provenance", "withdrawn"],
  "properties": {
    "schema_version": {"const": "0.1-draft"}, "fictional": {"type": "boolean"},
    "statement_id": {"$ref": "#/$defs/text"}, "proposal_id": {"$ref": "#/$defs/text"},
    "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "issued_at": {"type": "string", "format": "date"},
    "statement_kind": {"enum": ["reasoned_position", "technical_assessment", "delegated_approval"]},
    "verdict": {"enum": ["support", "object", "abstain", "unknown"]},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "operator", "control_domain", "model_system"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["human", "ai_system", "joint"]},
        "operator": {"$ref": "#/$defs/text"},
        "control_domain": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "model_system": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      },
      "allOf": [{"if": {"properties": {"kind": {"enum": ["ai_system", "joint"]}}}, "then": {"properties": {"model_system": {"$ref": "#/$defs/text"}}}}]
    },
    "mandate": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "principal", "reference", "scope", "valid_until"], "properties": {"kind": {"const": "delegated"}, "principal": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "valid_until": {"type": "string", "format": "date"}}}
      ]
    },
    "scope": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "conflicts": {"$ref": "#/$defs/text"},
    "independence": {
      "type": "object", "additionalProperties": false, "required": ["status", "basis"],
      "properties": {"status": {"enum": ["declared", "unknown", "disputed"]}, "basis": {"$ref": "#/$defs/text"}}
    },
    "provenance": {"$ref": "#/$defs/text"}, "withdrawn": {"type": "boolean"},
    "supersedes": {"$ref": "#/$defs/text"}
  },
  "allOf": [{"if": {"properties": {"statement_kind": {"const": "delegated_approval"}}}, "then": {"properties": {"verdict": {"const": "support"}, "mandate": {"properties": {"kind": {"const": "delegated"}}}}}}],
  "$defs": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"}}
}
